# Byte-compiled / optimized
__pycache__/
*.py[cod]
*$py.class

# Environments & virtualenvs
.venv/
venv/
ENV/

# Build and distribution
build/
dist/
*.egg-info/

# Target data & session logs (contain local operator data)
targets/*
!targets/.gitkeep

# Local drop-in recipes (a checkout's ./recipes.d is read like any other),
# apart from the sample
/recipes.d/*
!/recipes.d/example.yaml.sample

# Testing & caches
.pytest_cache/
.coverage
htmlcov/

# Editor, OS, and local developer configs
*:Zone.Identifier
.claude/settings.local.json
.DS_Store
.thumbnail
